<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key><string>zh_CN</string>
    <key>CFBundleExecutable</key><string>WireCamera</string>
    <key>CFBundleIdentifier</key><string>com.wirecamera.viewer</string>
    <key>CFBundleName</key><string>WireCamera</string>
    <key>CFBundleDisplayName</key><string>WireCamera</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>1.10.0</string>
    <key>CFBundleVersion</key><string>14</string>
    <key>CFBundleIconFile</key><string>AppIcon</string>
    <key>LSMinimumSystemVersion</key><string>14.0</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>NSCameraUsageDescription</key><string>用于预览摄像头画面，并在开启录制后自动保存到本机。画面不上传。</string>
    <key>NSMicrophoneUsageDescription</key><string>用于监听或录制摄像头自带的声音。声音仅在本机播放或保存，不上传。</string>
    <key>NSBluetoothAlwaysUsageDescription</key><string>用于发现摄像头模块，并通过蓝牙配置模块的 Wi-Fi 连接。Wi-Fi 密码不写入日志。</string>
    <key>NSLocalNetworkUsageDescription</key><string>用于发现并连接同一局域网内的摄像头模块。</string>
    <key>NSLocationUsageDescription</key><string>用于读取附近的 Wi-Fi 名称，供摄像头模块配网。不获取或保存定位坐标。</string>
    <key>NSLocationWhenInUseUsageDescription</key><string>用于读取附近的 Wi-Fi 名称，供摄像头模块配网。不获取或保存定位坐标。</string>
    <key>NSCameraUseContinuityCameraDeviceType</key><true/>
    <key>NSPrincipalClass</key><string>NSApplication</string>
</dict>
</plist>
